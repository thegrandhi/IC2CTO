{
  "name": "base-case-ios",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "marked": "^18.1.2",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/bundle-content.mjs",
    "content": "node scripts/bundle-content.mjs",
    "start": "node scripts/bundle-content.mjs && expo start",
    "ios": "node scripts/bundle-content.mjs && expo run:ios",
    "web": "node scripts/bundle-content.mjs && expo start --web",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && expo export --platform ios --output-dir dist-check && rm -rf dist-check",
    "lint": "expo lint"
  },
  "private": true
